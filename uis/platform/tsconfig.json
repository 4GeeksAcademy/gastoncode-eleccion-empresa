{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@website/*": ["../website/*"],
      "@dashboard/*": ["../backoffice/dashboard-backoffice/src/app/*"],
      "@auth/*": ["../backoffice/auth-shared/*"],
      "@suppliers/*": ["../backoffice/suppliers-management/src/*"],
      "@analyzer/*": ["../backoffice/incidents-analyzer/src/*"],
      "@manager/*": ["../backoffice/incidents-manager/src/*"],
      "@inventory/*": ["../backoffice/inventory-management/src/*"],
      "@talent/*": ["../backoffice/talent-pipeline-tracker/*"],
      "@brasaland/auth-shared/*": ["../backoffice/auth-shared/*"],
      "@brasaland/inventory-api": ["../../lib/inventory.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
