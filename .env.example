# Plantilla para el archivo `.env` requerido por el servicio API en Compose.
# Copia este archivo a .env y reemplaza el secreto JWT antes de exponer la API.
# En desarrollo local, scripts/backoffice.mjs genera un secreto efímero si falta.

# Necesario para iniciar la API unificada. Usa un valor aleatorio privado.
JWT_SECRET=replace-with-a-long-random-secret

# DATABASE_URL es opcional al iniciar la API, pero necesaria para inventario.
# Debe apuntar a una instancia PostgreSQL disponible; Compose no crea una.
DATABASE_URL=
FRONTEND_PORT=3007

# Correo de restablecimiento de contraseña. Sin clave Resend, el backend puede
# operar en modo de desarrollo y mostrar el enlace de restablecimiento en logs.
FRONTEND_URL=http://localhost:3007
RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Brasaland <noreply@brasaland.com>"

# Si se omite, talento usa el playground público con datos sintéticos.
# Para sobrescribirlo, configura TRACKER_API_URL con el endpoint autorizado.
# TRACKER_API_URL=https://playground.4geeks.com/tracker/api/v1

# CORS_ORIGINS no se define por defecto en este archivo; el código usa `*`
# cuando falta la variable. Este ejemplo restringe el origen de desarrollo.
# Para varios orígenes, sepáralos por comas y configúralos según el despliegue.
CORS_ORIGINS=http://localhost:3007

# En Compose, las bases TinyDB se guardan en el volumen /data. Las variables
# *_DB_PATH pueden sobrescribirse en ejecuciones directas del backend.
