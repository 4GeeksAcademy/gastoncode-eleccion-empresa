# Mapa de puertos del backoffice de Brasaland.
# Copia este archivo como .env.local dentro de cada app si necesitas cambiarlos.

# --- UIs ---
# dashboard-backoffice      -> 3000
# suppliers-management      -> 3001
# incidents-analyzer        -> 3002
# talent-pipeline-tracker   -> 3003

# --- APIs ---
# api-suppliers             -> 8000
# api-auth                  -> 8001
# api-incidents             -> 8002

# dashboard-backoffice
NEXT_PUBLIC_SUPPLIERS_UI_URL=http://localhost:3001
NEXT_PUBLIC_INCIDENTS_UI_URL=http://localhost:3002
NEXT_PUBLIC_TALENT_UI_URL=http://localhost:3003

# Enlace de vuelta al dashboard desde cada app
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# suppliers-management (usados por los rewrites de next.config.ts)
SUPPLIERS_API_URL=http://localhost:8000
AUTH_API_URL=http://localhost:8001

# incidents-analyzer
INCIDENTS_API_URL=http://127.0.0.1:8002

# talent-pipeline-tracker
NEXT_PUBLIC_TRACKER_API_URL=https://playground.4geeks.com/tracker/api/v1
