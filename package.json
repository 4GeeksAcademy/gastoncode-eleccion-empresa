{
  "name": "brasaland-digital",
  "private": true,
  "workspaces": [
    "uis/platform"
  ],
  "scripts": {
    "backoffice:setup": "node scripts/backoffice.mjs setup",
    "backoffice:dev": "node scripts/backoffice.mjs dev",
    "backoffice:check": "node scripts/backoffice.mjs check",
    "backoffice:admin": "node scripts/backoffice.mjs admin",
    "dev": "concurrently -c yellow,green,magenta,cyan \"npm:dev:*\"",
    "dev:platform": "npm run dev -w brasaland-platform",
    "build:platform": "npm run build -w brasaland-platform",
    "lint:platform": "npm run lint -w brasaland-platform",
    "typecheck:platform": "npm run typecheck -w brasaland-platform",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:auth:ts": "jest --coverage --config jest.config.cjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^9.1.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "uv": "^1.4.0"
  }
}
