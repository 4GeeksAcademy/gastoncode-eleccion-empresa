{
  "name": "brasaland-digital",
  "private": true,
  "workspaces": [
    "uis/backoffice/*"
  ],
  "scripts": {
    "backoffice:setup": "node scripts/backoffice.mjs setup",
    "backoffice:dev": "node scripts/backoffice.mjs dev",
    "backoffice:check": "node scripts/backoffice.mjs check",
    "backoffice:admin": "node scripts/backoffice.mjs admin",
    "dev": "concurrently -c yellow,green,magenta,cyan \"npm:dev:*\"",
    "dev:dashboard": "npm run dev -w dashboard-backoffice",
    "dev:suppliers": "npm run dev -w suppliers-backoffice",
    "dev:incidents": "npm run dev -w incidents-analyzer",
    "dev:incidents-manager": "npm run dev -w incidents-manager",
    "dev:talent": "npm run dev -w talent-pipeline-tracker",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:auth:ts": "jest --coverage --config jest.config.cjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^9.1.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "uv": "^1.4.0"
  }
}
